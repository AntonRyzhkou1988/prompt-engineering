{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SystemSettings": {
    "AiServiceSettings": {
      "BaseAddress": "BaseAddress",
      "HandlerLifetimeInSeconds": 1800,
      "TimeoutInSeconds": 180,
      "Retry": {
        "RetryCount": 3,
        "BackoffBase": 2
      },
      "SystemName": "openai",
      "ChatUrl": "chat",
      "CompletionsUrl": "completions",
      "DeploymentsUrl": "deployments",
      "EmbeddingsUrl": "embeddings",
      "Instances": [
        {
          "Name": "AIArchitect.Agent.Low",
          "ApiKey": "DialApiKey",
          "Deployment": "gpt-5.2-2025-12-11",
          "EmbeddingDeployment": "text-multilingual-embedding-002"
        },
        {
          "Name": "AIArchitect.Agent.Medium",
          "ApiKey": "DialApiKey",
          "Deployment": "gpt-5.1-2025-11-13",
          "EmbeddingDeployment": "text-embedding-ada-002"
        },
        {
          "Name": "AIArchitect.Agent.High",
          "ApiKey": "DialApiKey",
          "Deployment": "gemini-2.5-pro",
          "EmbeddingDeployment": "gemini-embedding-001"
        }
      ]
    }
  },
  "Agent": {
    "InstanceName": "AIArchitect.Agent.High",
    "Temperature": 0.2,
    "MaxFunctionIterations": 7,
    "OpenMeteo": {
      "Command": "npx",
      "Name": "open-meteo-mcp",
      "Arguments": [ "-y", "-p", "open-meteo-mcp-server", "open-meteo-mcp-server" ],
      "Environment": {}
    },
    "DuckDuckGo": {
      "Command": "npx",
      "Name": "duckduckgo-mcp",
      "Arguments": [ "-y", "@ericthered926/duckduckgo-mcp-server" ],
      "Environment": {
        "DDG_MAX_RESULTS": "5",
        "DDG_MAX_SNIPPET_LENGTH": "300"
      }
    },
    "ToolRouting": {
      "WeatherToolNameSubstrings": [
        "openmeteo"
      ],
      "NewsToolNameSubstrings": [ "duckduckgo_web_search" ]
    }
  }
}
